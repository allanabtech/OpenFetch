{
  "name": "openfetch",
  "version": "0.1.0",
  "private": true,
  "description": "The last download manager you'll ever need.",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "tauri": "pnpm --filter desktop tauri"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
